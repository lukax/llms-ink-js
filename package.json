{
  "name": "llms-ink",
  "version": "0.5.0",
  "description": "Turn any link — site, docs section, page, GitHub repo, PDF or video — into llms.txt and llms-full.txt. Typed client for llms.ink, plus a Vite plugin, an Astro integration and middleware that serve the files from your site. No dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/lukax/llms-ink-js.git" },
  "bugs": "https://github.com/lukax/llms-ink-js/issues",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run build && node --test test/client.test.mjs test/plugins.test.mjs test/middleware.test.mjs test/traffic.test.mjs test/inspect.test.mjs",
    "test:live": "npm run build && node --test test/live.test.mjs",
    "test:bun": "npm run build && bun test ./test/client.test.mjs ./test/plugins.test.mjs ./test/middleware.test.mjs ./test/traffic.test.mjs ./test/inspect.test.mjs",
    "test:bun:live": "npm run build && bun test --timeout 300000 ./test/live.test.mjs"
  },
  "keywords": ["llms.txt", "llms-full.txt", "llm", "ai", "markdown", "docs", "context", "rag", "sdk", "llms-ink", "vite-plugin", "astro-integration", "middleware"],
  "homepage": "https://llms.ink/docs/",
  "author": "Lucas Espindola (https://lucasespindola.com)",
  "license": "MIT",
  "peerDependencies": {
    "astro": ">=4",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "astro": "^7.4.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
